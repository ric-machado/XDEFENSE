# syntax=docker/dockerfile:1
# Sandbox variant do Dockerfile.scheduler — usa node_modules/dist pré-buildados no host.

FROM node:20-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/xorcism_ts

COPY xorcism_ts/node_modules ./node_modules
COPY xorcism_ts/dist ./dist
COPY xorcism_ts/package.json ./package.json
COPY databases /app/databases
COPY connectors /app/connectors

VOLUME /data

ENV NODE_ENV=production \
    DB_DIR=/data \
    SCHEDULER_ONLY=true

RUN useradd --no-create-home --shell /bin/false scheduler && \
    mkdir -p /data && chown scheduler:scheduler /data /app
USER scheduler

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "dist/server/scheduler_entrypoint.js"]
