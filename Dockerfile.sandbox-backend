# syntax=docker/dockerfile:1
#
# Sandbox variant — usa assets pré-buildados no host, mas recompila melhor-sqlite3
# dentro do container para compatibilidade de glibc.

# ── Rebuild stage (node:20-bookworm tem build tools, same glibc que -slim) ────
FROM node:20-bookworm AS rebuild
WORKDIR /app/xorcism_ts
COPY xorcism_ts/node_modules ./node_modules
COPY xorcism_ts/package.json ./package.json
# Recompila o addon nativo para o glibc do container (host pode ter versão diferente)
RUN npm rebuild better-sqlite3 2>&1 | tail -5 || true

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="XORCISM" \
      org.opencontainers.image.description="Open unified cybersecurity management platform" \
      org.opencontainers.image.vendor="XORCISM"

ENV NODE_ENV=production \
    DB_DIR=/data \
    PORT=9292

WORKDIR /app/xorcism_ts

COPY --from=rebuild /app/xorcism_ts/node_modules ./node_modules
COPY xorcism_ts/dist ./dist
COPY xorcism_ts/package.json ./package.json
COPY xorcism_ts/client ./client
COPY databases /app/databases
COPY connectors /app/connectors

VOLUME /data
RUN mkdir -p /data && chown -R node:node /data /app
USER node

EXPOSE 9292
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
    CMD node -e "require('http').get('http://localhost:9292/login', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/server/index.js"]
