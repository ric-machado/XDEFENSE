# XDEFENSE — Variáveis de Ambiente
# Copie para .env e execute ./setup.sh (que gera senhas automaticamente)
# NUNCA comite o arquivo .env no repositório.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
POSTGRES_DB=xdefense
POSTGRES_USER=postgres

# ── PgBouncer ─────────────────────────────────────────────────────────────────
PGBOUNCER_AUTH_USER=xdefense_app
PGBOUNCER_AUTH_PASSWORD=CHANGE_ME_APP_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://xdefense:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/xdefense

# ── Aplicação Node.js ─────────────────────────────────────────────────────────
PORT=9292
NODE_ENV=production
DB_DIR=/data
APP_SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_64_CHARS

# Seleção de engine: sqlite (default, deploy de validação) | postgres
# ATENÇÃO: hoje isto só comuta o lado Python (importers/connectors/TAXII).
# O servidor Node (xorcism_ts) continua síncrono sobre SQLite/libSQL
# independentemente deste valor (Stage 2 / Route C ainda não implementada —
# ver docs/DATABASE_BACKENDS_STAGE2.md). Definir "postgres" aqui faz o
# Python gravar num banco que o Node não lê: os dois processos avisam isso
# no log de boot, mas a divergência de dados é real. Mantenha "sqlite" para
# deploy de validação.
XDEFENSE_DB_ENGINE=sqlite

# ── Vault (criptografia de campos sensíveis) ──────────────────────────────────
VAULT_KEY=CHANGE_ME_VAULT_KEY_MIN_32_CHARS

# ── TAXII Server ──────────────────────────────────────────────────────────────
TAXII_HOST=0.0.0.0
TAXII_PORT=5000
TAXII_AUTH=1
TAXII_PASSWORD=CHANGE_ME_TAXII_PASSWORD
TAXII_BACKEND=sqlite
TAXII_DB=/data/taxii.db

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Integrações Externas (opcionais) ─────────────────────────────────────────
NVD_API_KEY=
TAXII_PROXY_URL=http://taxii:5000
OSV_API_URL=https://api.osv.dev
CIRCL_API_URL=https://vulnerability.circl.lu
XORCISM_ALLOW_REGISTER=0
XORCISM_BASE_URL=https://localhost

# ── SMTP (opcional — para notificações por e-mail) ───────────────────────────
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@xdefense.local

# ── Ollama / IA (opcional — ative com --profile ai) ─────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
