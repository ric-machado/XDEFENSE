FROM postgres:16-alpine

# busybox crond já está disponível no alpine — nenhum pacote adicional necessário

COPY scripts/backup.sh /usr/local/bin/backup.sh
RUN chmod +x /usr/local/bin/backup.sh

VOLUME ["/backups", "/data"]

CMD ["sh", "-c", "echo \"${BACKUP_SCHEDULE:-0 2 * * *} /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1\" | crontab - && crond -f -l 2"]
