# syntax=docker/dockerfile:1
# XDEFENSE — Scheduler
# Roda tarefas periódicas (connector schedule, importers) independentemente do
# processo Node.js principal. Em Fase 7 será substituído por RabbitMQ SchedulerWorker.

# ── Build stage ─────────────────────────────────────────────────────────────────
FROM node:20-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/xorcism_ts

COPY xorcism_ts/package.json xorcism_ts/package-lock.json ./
RUN npm ci

COPY xorcism_ts/ ./
RUN npm run build && npm prune --omit=dev

# ── Runtime stage ────────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="XDEFENSE Scheduler" \
      org.opencontainers.image.description="Periodic task scheduler for XDEFENSE platform"

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/xorcism_ts

COPY --from=builder /app/xorcism_ts/node_modules ./node_modules
COPY --from=builder /app/xorcism_ts/dist ./dist
COPY --from=builder /app/xorcism_ts/package.json ./package.json
COPY databases /app/databases
COPY connectors /app/connectors

VOLUME /data

ENV NODE_ENV=production \
    DB_DIR=/data \
    SCHEDULER_ONLY=true

RUN useradd --no-create-home --shell /bin/false scheduler && \
    mkdir -p /data && chown scheduler:scheduler /data /app
USER scheduler

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "process.exit(0)"

CMD ["node", "dist/server/scheduler.js"]
